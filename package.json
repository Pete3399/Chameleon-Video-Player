{
  "name": "ChameleonPlayer",
  "version": "2.0.0",
  "description": "Play video transparently full screen while working in the background",
  "main": "main.js",
  "homepage": "https://www.cinqmarsmedia.com/",
  "scripts": {
    "start": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "electronVersion": "33.0.0",
    "productName": "Chameleon Player",
    "appId": "com.cinqmarsmedia.chameleon",
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "icon": "./build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "./build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Cinq-Mars Media",
      "icon": "./build/icons"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always"
    }
  },
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "electron-storage": "^1.0.7",
    "menubar": "^9.4.0"
  },
  "author": {
    "name": "Christopher Cinq-Mars Jarvis",
    "email": "info@cinqmarsmedia.com"
  },
  "license": "",
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
